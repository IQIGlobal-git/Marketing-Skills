# AI Provider API Keys (all optional — users can add keys via Settings page)
# Google Gemini (free tier) — get one at aistudio.google.com/apikey
GEMINI_API_KEY=your-gemini-api-key-here
# Groq (free tier) — get one at console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
# OpenAI (paid) — get one at platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
# Anthropic (paid) — get one at console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# fal.ai (image generation) — get one at fal.ai/dashboard/keys
FAL_KEY=your-fal-api-key-here
